#!/usr/bin/env python3
# セッションダッシュボード（概要とセットアップは session-dashboard/README.md）
#
# 使い方:
#   session-dashboard [--peer HOST]            一覧を表示
#   session-dashboard [--peer HOST] --rm ID    停止中の記録を消す
# 内部用（_ で始まるもの）:
#   _hook     Claude Code の hook から呼ぶ（標準入力に hook の JSON）
#   _record   記録係。Stop の hook から非同期で呼ぶ（標準入力に hook の JSON）
#   _dump     このサーバーの記録を判定済みの JSON で出す（相手側では ssh 越しに標準入力からこのスクリプトを読んで動かす）
#   _rm SESSION_ID HASH  停止中の記録を、呼んだ側で読んだ記録のまま（ハッシュが同じ）なら消す
#
# 相手側では「ssh HOST python3 - _dump < このファイル」で動かすので、標準ライブラリだけで書き、古い python3 でも動く書き方にする
import contextlib
import hashlib
import fcntl
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import tempfile
from datetime import datetime

STATE_DIR = os.path.expanduser("~/.local/state/session-dashboard")
HERE = os.path.dirname(os.path.realpath(__file__))
HOST = socket.gethostname().split(".")[0]
IMPORTANCE = {"low": 10, "mid": 20, "high": 30, "urgent": 40}
EFFORT = {"short": 0, "mid": 1, "long": 2}
INTERRUPTED = "[Request interrupted by user"
NO_PURPOSE = "（目的は未設定）"
# 本業ではないディレクトリ（cwd がこの配下のセッションは、重要度の初期値を low にする。会話で訂正されれば記録係が従う）
LOW_IMPORTANCE_DIRS = ("~/setup",)
DAY = 86400
STOPPED_KEEP_DAYS = 7  # 停止中の記録は、最後に書き換えてからこの日数で消す
SSH_OPTS = ["-o", "ControlMaster=auto", "-o", "ControlPath=~/.ssh/cm-%C", "-o", "ControlPersist=10m", "-o", "BatchMode=yes"]


def now(timespec="seconds"):
	return datetime.now().astimezone().isoformat(timespec=timespec)


_boot_id = None


def boot_id():
	"""今の起動の ID（一覧では記録ごとに使うので、一度読んだら覚えておく）"""
	global _boot_id
	if _boot_id is None:
		with open("/proc/sys/kernel/random/boot_id") as f:
			_boot_id = f.read().strip()
	return _boot_id


def path_of(sid, suffix=".json"):
	return os.path.join(STATE_DIR, sid + suffix)


# ── 記録ファイルの読み書き ───────────────────────────────


def read_record(sid):
	try:
		with open(path_of(sid), encoding="utf-8") as f:
			return json.load(f)
	except FileNotFoundError:
		return None
	except ValueError:
		return None  # 壊れた記録（書きかけで落ちたなど）は無いものとして扱う。次の指示かセッションの始まりで作り直される


def write_record(meta):
	path = path_of(meta["session_id"])
	tmp = path + ".tmp"
	with open(tmp, "w", encoding="utf-8") as f:
		json.dump(meta, f, ensure_ascii=False, indent=1)
	os.replace(tmp, path)


@contextlib.contextmanager
def locked(name="records"):
	"""ロックを取る。既定は記録ファイルの読み書きの間だけ取る短いロック（hook・記録係・一覧の書き込みが互いに上書きしないように）
	セッションごとに分けないのは、ロックファイルを消せる時が無く溜まるため（消すと、待っていたプロセスと後から開いたプロセスで排他が効かなくなる）"""
	with open(os.path.join(STATE_DIR, name + ".lock"), "w") as f:
		fcntl.flock(f, fcntl.LOCK_EX)
		yield


def session_ids():
	return [n[:-5] for n in os.listdir(STATE_DIR) if n.endswith(".json")]


# 一覧を作るときに記録へ足す、表示のための項目（記録ファイルには無い）
VIEW_KEYS = ("server", "label", "state", "local")


def digest(meta):
	"""記録の中身のハッシュ（表示のための項目は除く）。相手に記録の中身を渡さずに、同じ記録かを確かめるのに使う"""
	seen = {k: v for k, v in meta.items() if k not in VIEW_KEYS}
	return hashlib.sha256(json.dumps(seen, sort_keys=True, ensure_ascii=False).encode("utf-8")).hexdigest()


def unchanged(seen_digest):
	"""記録が seen_digest を取ったときのまま（再開も、hook の書き込みもされていない）かを調べる関数を返す（remove_record に渡す）"""
	return lambda current: digest(current) == seen_digest


def remove_record(sid, ok):
	"""ok(今の記録) が真のときだけ記録を消す。記録が無くなっていれば真、残したときは偽を返す
	ロックの中で確かめて消す（確かめた後に再開された記録や、ロック中に読んだ記録を、消した後で書き戻されないように）"""
	with locked():
		current = read_record(sid)
		if current is None:
			return True  # ほかのプロセスが先に消した
		if not ok(current):
			return False
		for suffix in (".json", ".json.tmp"):
			with contextlib.suppress(FileNotFoundError):
				os.remove(path_of(sid, suffix))
		return True


def entries(lines):
	"""transcript（JSONL）の各行を読む。壊れた行（書きかけなど）は飛ばす"""
	for line in lines:
		try:
			yield json.loads(line)
		except ValueError:
			pass


def messages(lines):
	"""transcript の行のうち、ユーザーと AI の発言だけを返す（isMeta や /compact の要約など、発言でないものは飛ばす）"""
	for entry in entries(lines):
		if entry.get("type") in ("user", "assistant") and not entry.get("isMeta") and not entry.get("isCompactSummary"):
			yield entry


def message_texts(content):
	if isinstance(content, str):
		return [content]
	return [c.get("text", "") for c in content if c.get("type") == "text"]


# ── hook ─────────────────────────────────────────────


# hook のコマンドを動かすシェル（claude_pid で飛ばす）
SHELLS = ("sh", "bash", "dash", "zsh", "env")


def claude_pid():
	"""hook を起動した claude の pid（分からなければ None）
	祖先のうちシェルを除いた一番近いプロセスを、コマンド行に claude を含み、claude が子に渡す CLAUDE_PID とも合うときだけ使う
	（親を見失って init や claude daemon に付け替えられた hook で、別のプロセスを取らないように）
	プロセス名が claude の祖先までは遡らない。バックグラウンドのセッションは claude daemon の子で動き、名前がバージョン番号になるので、
	遡ると同じ daemon の他のセッションと pid が重なり、detach_others で生きているのに停止中にされる"""
	given = os.environ.get("CLAUDE_PID")
	pid = os.getppid()
	try:
		while pid > 1:
			name, fields = proc_stat(pid)
			if name not in SHELLS:
				if given is not None:
					return pid if given == str(pid) else None
				with open("/proc/%d/cmdline" % pid, "rb") as f:
					return pid if b"claude" in f.read() else None
			pid = int(fields[1])
	except OSError:
		pass  # たどっている間に終わった
	return None


def proc_stat(pid):
	"""/proc/PID/stat のプロセス名と、その後ろの欄（state から。[1] が親の pid、[19] が起動時刻）"""
	with open("/proc/%d/stat" % int(pid)) as f:
		stat = f.read()
	return stat[stat.index("(") + 1 : stat.rindex(")")], stat[stat.rindex(")") + 2 :].split()


UNKNOWN_START = "?"


def proc_start(pid):
	"""プロセスの起動時刻（/proc/PID/stat の 22 番目。pid が使い回されても見分けられる）。プロセスが無ければ None"""
	try:
		return proc_stat(pid)[1][19]
	except PermissionError:
		return UNKNOWN_START  # /proc を読めない環境（hidepid など）
	except (OSError, TypeError, ValueError):
		return None


def running(meta):
	"""記録の claude のプロセスが今も動いているか。pid が使い回されていれば動いていないとみなす
	pid が分からない記録と、/proc を読めない環境では、同じ起動の間は動いているとみなす"""
	if meta.get("boot_id") != boot_id():
		return False
	if not meta.get("pid"):
		return True
	start = proc_start(meta["pid"])
	if start == UNKNOWN_START:
		return True  # 見分けられないので、動いているとみなす
	# 記録したときに /proc を読めなかったものは起動時刻で見分けない
	# 起動時刻の無い古い記録は、pid が使い回されたかを見分けられないので止まっているとみなす（動いていれば次の指示で結び付け直す）
	return start is not None and meta.get("pid_start") in (UNKNOWN_START, start)


def alive(meta):
	"""記録のセッションが動いているか（離れた印が無く、プロセスが動いている）"""
	return not meta.get("detached") and running(meta)


def set_status(meta, status):
	"""status を変える。変わったかどうかを返す"""
	if meta.get("status") == status:
		return False
	meta["status"] = status
	return True


# ユーザーの答えを待つツール。動いている間は自分の番（README の PreToolUse の matcher と揃える）
WAIT_TOOLS = ("AskUserQuestion", "ExitPlanMode")
TOOL_EVENTS = ("PreToolUse", "PostToolUse", "PostToolUseFailure")
# UserPromptSubmit で届くが、ユーザーの指示ではない知らせ（バックグラウンドの作業の完了・サブエージェントの報告）
NOT_USER_PROMPTS = ("<task-notification>", "<agent-message")


def under(path, d):
	"""path が d そのものか、その配下か"""
	return path == d or path.startswith(d + "/")


def update_status(meta, event, data):
	"""Stop・StopFailure・Notification・PreToolUse・PostToolUse(Failure) の後に status を変える。記録が変わったかどうかを返す
	許可に答えた瞬間を知らせるイベントは無いので、ツールの前後で作業中に戻す
	Stop では、後で AI を呼び戻すもの（まだ動いているバックグラウンドの作業・cron）を waiting_for に覚える（一覧では待機中に出す）
	waiting_for は直前の Stop で覚えたものだけ使う（その後に確認や作業が始まれば外す）"""
	tool = data.get("tool_name")
	old_waiting = meta.pop("waiting_for", None)
	if event in TOOL_EVENTS:
		status = "user_turn" if event == "PreToolUse" and tool in WAIT_TOOLS else "ai_working"
	else:
		status = "user_turn"
	if event in ("Stop", "StopFailure"):  # StopFailure で作業の一覧が届かなければ、待ちは無いとみなす
		tasks = [t for t in data.get("background_tasks") or [] if t.get("status") == "running"] + list(data.get("session_crons") or [])
		if tasks:
			meta["waiting_for"] = [t.get("description") or t.get("prompt") or t.get("type") or "?" for t in tasks]
	return set_status(meta, status) or meta.get("waiting_for") != old_waiting


def new_record(data, where):
	t = now()
	meta = {"session_id": data["session_id"], "started_at": t}
	meta.update(where)
	cwd = meta["cwd"]
	importance = "low" if any(under(cwd, d) for d in LOW_IMPORTANCE_DIRS) else "mid"
	meta.update({"status": "user_turn", "priority": {"importance": importance, "effort": "mid"}})
	# fork したセッションは、コピーされた親の会話を記録係に読ませない（分岐後の依頼から目的を作らせる）
	# この時点では transcript がまだ無いので位置では区切れない。コピーされた発言は親のときの timestamp のままなので、時刻で区切る
	if data.get("source") == "fork":
		meta["copied_before"] = t
	return meta


def detach_others(sid, pid, pid_start, boot):
	"""同じ claude のプロセスにいた他のセッション（/branch した親など）に、プロセスを離れた印を付ける。記録のロックの中で呼ぶ
	SessionEnd が来ないまま別のセッションに切り替わっても、生きているように見えないように（一覧では停止中に出す）"""
	for other in session_ids():
		meta = read_record(other)
		if meta is None or other == sid or meta.get("detached"):
			continue  # 印の付いたものは書き直さない（7 日の期限が延びないように）
		# 起動時刻も比べる（pid が使い回された、別の古いプロセスの記録には付けない）
		start_ok = pid_start == UNKNOWN_START or meta.get("pid_start") in (None, UNKNOWN_START, pid_start)
		if meta.get("pid") == pid and meta.get("boot_id") == boot and start_ok:
			meta["detached"] = True
			write_record(meta)


TAG_NAME = r"[A-Za-z_][\w.:-]*"
PROMPT_CUT = 2000


def strip_tags(text):
	"""貼り付けなどの囲みのタグ（開きと閉じが対になったもの）を外して中身だけにする。入れ子は外側から順に外す"""
	for _ in range(5):  # 深い入れ子で遅くならないよう、外す段数に上限を付ける
		stripped = re.sub(r"<(%s)(\s[^>]*)?>(.*?)</\1(\s[^>]*)?>" % TAG_NAME, r" \3 ", text, flags=re.S)
		if stripped == text:
			break
		text = stripped
	return text


def attach(sid, meta, data):
	"""このプロセスで動いているセッションとして記録する（無ければ作る）"""
	home = os.path.expanduser("~")
	cwd = data["cwd"]
	pid = claude_pid()
	where = {
		"cwd": "~" + cwd[len(home) :] if under(cwd, home) else cwd,
		"pid": pid,
		"pid_start": proc_start(pid),
		"boot_id": boot_id(),
		"transcript_path": data["transcript_path"],
		"attached_at": now("milliseconds"),  # 引き継ぎの印（ミリ秒まで）と比べる
	}
	if meta:
		if data.get("source") not in ("compact", "clear"):
			meta.pop("waiting_for", None)  # 待ちは、同じ流れの中の /compact・/clear のときだけ残す（再開した時点の作業は分からない）
		meta.update(where)
		meta.pop("detached", None)
		if data.get("source") == "resume":
			set_status(meta, "user_turn")  # 再開した直後は入力待ち
	else:
		meta = new_record(data, where)
	if where["pid"]:
		detach_others(sid, where["pid"], where["pid_start"], where["boot_id"])
	return meta


def hook(data):
	event, sid = data["hook_event_name"], data["session_id"]
	if os.environ.get("CLAUDE_CODE_ENTRYPOINT", "cli") != "cli":
		return  # 対話モード以外（claude -p・Agent SDK）は対象外。-p では sdk-cli になる
	if event in TOOL_EVENTS and data.get("agent_id"):
		return  # サブエージェントのツールでは動かさない（応答が終わった後のバックグラウンドのエージェントで作業中に戻らないように）
	if event == "SessionEnd":
		# 同じセッションを別のプロセスで再開して、そちらが動いているときだけ記録を残す
		# 終わり際の hook は親を見失って claude_pid が取れないことがあり、そのときは自分の記録とみなして消す。pid の無い記録も消す
		me = claude_pid()
		remove_record(sid, lambda m: not (me and m.get("pid") not in (None, me) and alive(m)))
		return
	with locked():
		meta = read_record(sid)
		instructed = event == "UserPromptSubmit" and not data.get("prompt", "").startswith(NOT_USER_PROMPTS)
		# 記録はセッションの始まりかユーザーの指示のときに作る（導入前から動いているセッションや、記録が壊れたときも拾う）
		# ほかの hook や作業の完了の知らせでは作らない（SessionEnd や引き継ぎで消した後に、遅れて来た hook で生き返らないように）
		if meta is None and not (event == "SessionStart" or instructed):
			return
		# 離れた印が付いた・止まっているように見える記録に指示が来たら、このプロセスで動いているので結び付け直す
		# 作業の完了の知らせも動いているプロセスからしか来ないので、結び付け直す（記録を新しく作るのはユーザーの指示のときだけ）
		changed = meta is None or event == "SessionStart" or (event == "UserPromptSubmit" and not alive(meta))
		if changed:
			meta = attach(sid, meta, data)
		if event == "UserPromptSubmit":
			set_status(meta, "ai_working")
			meta.pop("waiting_for", None)
			if instructed:
				full = data.get("prompt", "")
				prompt = strip_tags(full[:PROMPT_CUT])  # 表示は 80 文字だけなので、大きな貼り付けをタグの処理の前に切る
				if len(full) > PROMPT_CUT:  # 切って閉じタグが無くなった、先頭の開きタグ（入れ子も 5 段まで）
					prompt = re.sub(r"^(\s*<%s(\s[^>\n]{0,200})?>){1,5}" % TAG_NAME, " ", prompt)
				meta["last_prompt"] = " ".join(prompt.split())[:80]
				meta["last_prompt_at"] = now()
			changed = True
		elif event != "SessionStart":
			changed = update_status(meta, event, data) or changed
		if changed:  # PreToolUse・PostToolUse はツールのたびに来るので、変わらなければ書き直さない
			write_record(meta)


# ── 記録係 ────────────────────────────────────────────

SCHEMA = {
	"type": "object",
	"properties": {
		"purpose": {"type": "string"},
		"ai_result": {"type": "string"},
		"importance": {"enum": list(IMPORTANCE)},
		"effort": {"enum": list(EFFORT)},
	},
	"required": ["purpose", "ai_result", "importance", "effort"],
}


def parse_time(s):
	return datetime.fromisoformat(s.replace("Z", "+00:00"))  # 古い python3 は Z を読めない


def conversation(raw, copied_before=None):
	"""transcript（JSONL）から、発言とツール名だけを取り出して読みやすくする
	copied_before があれば、それより前の発言（fork でコピーされた親の会話）は飛ばす"""
	out = []
	cutoff = parse_time(copied_before) if copied_before else None
	for entry in messages(raw.splitlines()):
		if cutoff and parse_time(entry.get("timestamp", copied_before)) < cutoff:
			continue
		content = entry.get("message", {}).get("content", "")
		who = "ユーザー" if entry["type"] == "user" else "AI"
		out += ["%s: %s" % (who, t[:3000]) for t in message_texts(content) if t.strip()]
		if isinstance(content, list):
			out += ["AI: （%s を使用）" % c.get("name") for c in content if c.get("type") == "tool_use"]
	text = "\n".join(out)
	# 長すぎるときは、目的を作るための冒頭と、直近のやり取りだけを残す
	return text if len(text) <= 60000 else text[:10000] + "\n…（中略）…\n" + text[-50000:]


def file_inode(path):
	try:
		return os.stat(os.path.expanduser(path)).st_ino
	except OSError:
		return None


def record(data):
	sid = data["session_id"]
	if not os.path.exists(path_of(sid)):
		return
	# 同じセッションの記録係は順番に動かす。後から来たものは、前のものが拾い残した分をまとめて拾う
	# 消えたセッションのロックファイルは purge_files が消す。消すときに動いていても、同じ要約を 2 回するだけで害は無い
	with locked(sid + ".rec"):
		meta = read_record(sid)
		if meta is None:
			return
		offset = meta.get("transcript_offset", 0)
		try:
			with open(os.path.expanduser(meta["transcript_path"]), "rb") as f:
				st = os.fstat(f.fileno())
				inode = st.st_ino
				if inode != meta.get("transcript_inode") or offset > st.st_size:
					offset = 0  # 同じ場所に transcript が作り直された
				f.seek(offset)
				raw = f.read()
		except FileNotFoundError:
			return  # transcript がまだ無い（再開した直後など）。次の Stop で拾う
		raw = raw[: raw.rfind(b"\n") + 1]  # 書きかけの行は次回に回す
		if not raw:
			return
		decoded = raw.decode("utf-8", "replace")
		text = conversation(decoded, meta.get("copied_before"))
		title = custom_title(decoded.splitlines())  # 記録のロックは全セッションで共有なので、重い処理はロックの外でする
		result = summarize(meta, text) if text else None
		with locked():
			read_from = (meta.get("started_at"), meta["transcript_path"])
			meta = read_record(sid)
			if meta is None or (meta.get("started_at"), meta["transcript_path"]) != read_from or file_inode(meta["transcript_path"]) != inode:
				return  # 要約している間にセッションが閉じられた・別の transcript で再開された・作り直された（読んだ位置は今の記録には合わない）
			if result:
				# purpose は記録係の指示文で「原則変えない。ユーザーが変更を言ったときだけ変える」としている
				meta["purpose"] = result["purpose"]
				meta["ai_result"] = result["ai_result"]
				meta["priority"] = {"importance": result["importance"], "effort": result["effort"]}
			if title:
				meta["title"] = title
			meta["transcript_offset"] = offset + len(raw)
			meta["transcript_inode"] = inode
			write_record(meta)


def summarize(meta, text):
	with open(os.path.join(HERE, "recorder-prompt.md"), encoding="utf-8") as f:
		system = f.read()
	current = {k: meta.get(k, "") for k in ("purpose", "ai_result", "priority")}
	prompt = "# 現在の記録\n%s\n\n# 新しく増えた会話\n%s" % (json.dumps(current, ensure_ascii=False), text)
	# 作業中のセッションの環境変数を引き継がない（ログインに使うものは残す）。環境変数とフラグの扱いは .bashrc の _tab_autoname_start と揃える
	env = {k: v for k, v in os.environ.items() if not k.startswith("CLAUDE") or k in ("CLAUDE_CONFIG_DIR", "CLAUDE_CODE_OAUTH_TOKEN") or k.startswith("CLAUDE_CODE_USE_")}
	# disableAllHooks で、記録係自身の呼び出しで hook が動く（記録ファイルができる・記録係が再帰的に動く）のを防ぐ
	cmd = ["claude", "-p", "--model", "haiku", "--tools", "", "--settings", '{"disableAllHooks":true}', "--strict-mcp-config", "--mcp-config", "", "--disable-slash-commands", "--output-format", "json", "--no-session-persistence", "--json-schema", json.dumps(SCHEMA), "--system-prompt", system]
	out = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=300, env=env, cwd=STATE_DIR, check=True).stdout
	reply = json.loads(out)
	if reply.get("is_error"):
		raise RuntimeError("claude がエラーを返しました: %s" % reply.get("result"))
	return reply["structured_output"]


# ── 一覧 ──────────────────────────────────────────────


def tail_lines(transcript_path):
	"""transcript の末尾（64KB）の行。読めなければ空"""
	try:
		with open(os.path.expanduser(transcript_path), "rb") as f:
			f.seek(max(0, os.path.getsize(f.name) - 65536))
			return f.read().decode("utf-8", "replace").splitlines()
	except OSError:
		return []


def last_entry(lines, entry_type):
	"""lines のうち、type が entry_type の最後の行（無ければ None）。該当する行は少ないので、文字列で絞ってから解析する"""
	for entry in entries(l for l in reversed(lines) if '"%s"' % entry_type in l):
		if entry.get("type") == entry_type:
			return entry
	return None


def handed_over(lines, attached_at):
	"""会話が別のセッションに引き継がれたままか（引き継ぎの印より後に、このプロセスで動き始めて再開したものは偽）"""
	entry = last_entry(lines, "continued-in")
	if not entry or not attached_at:
		return False  # 動き始めた時刻の無い古い記録は、再開したかが分からないので消さない（停止していれば 7 日後に消える）
	try:
		return parse_time(entry["timestamp"]) >= parse_time(attached_at)
	except (AttributeError, KeyError, TypeError, ValueError):
		return False  # 時刻を読めない（古い python3 には fromisoformat が無い）


def custom_title(lines):
	"""/rename で付けたセッション名のうち最後のもの（無ければ None）"""
	return (last_entry(lines, "custom-title") or {}).get("customTitle")


def interrupted(lines):
	"""transcript の最後の発言が、Esc による中断かどうか"""
	for entry in messages(reversed(lines)):
		texts = message_texts(entry.get("message", {}).get("content", ""))
		# 中断の後に打ったローカルのコマンド（/model・! のシェルモードなど。AI は動かない）の記録は飛ばす
		if any(t.startswith(("<command-name>", "<local-command-", "<bash-")) for t in texts):
			continue
		return entry["type"] == "user" and any(t.startswith(INTERRUPTED) for t in texts)
	return False


def modified(path):
	"""最後に書き換えた時刻（ほかのプロセスが消していたら 0）"""
	try:
		return os.path.getmtime(path)
	except FileNotFoundError:
		return 0


ERROR_LOG_MAX = 100000


def rotate_error_log():
	"""error.log が大きくなったら error.log.old に移す（名前を変えるだけなので、書いている途中の行も消えない。.old は purge_files が 1 日後に消す）"""
	path = os.path.join(STATE_DIR, "error.log")
	if not os.path.exists(path) or os.path.getsize(path) <= ERROR_LOG_MAX:
		return  # ふだんはロックを取らずに済ませる
	with locked(), contextlib.suppress(FileNotFoundError):  # 同時に動く一覧が、移したばかりのものを上書きしないように確かめ直す
		if os.path.getsize(path) > ERROR_LOG_MAX:
			os.replace(path, path + ".old")
			os.utime(path + ".old")  # purge_files が 1 日は残すように、移した時刻にする


def purge_files():
	"""記録・記録のロック・エラーのログ以外の、1 日たったファイルを消す（記録係のロック・古い形式の記録・書きかけ）"""
	limit = datetime.now().timestamp() - DAY
	for name in os.listdir(STATE_DIR):
		if name.endswith(".json") or name in ("records.lock", "error.log"):
			continue
		if name.endswith(".rec.lock") and os.path.exists(path_of(name.split(".")[0])):
			continue  # 記録のあるセッションの記録係のロック
		path = os.path.join(STATE_DIR, name)
		with contextlib.suppress(FileNotFoundError):  # 調べている間に、書きかけが記録に置き換わる・ほかのプロセスが消すことがある
			if os.path.getmtime(path) < limit:
				os.remove(path)


def judge(meta):
	"""停止中か、と transcript の末尾の行を返す"""
	return not alive(meta), tail_lines(meta.get("transcript_path", ""))


def dump():
	"""このサーバーの記録を、表示する欄（state）を判定して返す"""
	out = []
	if not os.path.isdir(STATE_DIR):
		return out
	purge_files()
	rotate_error_log()
	expire = datetime.now().timestamp() - STOPPED_KEEP_DAYS * DAY
	for sid in session_ids():
		meta = read_record(sid)
		if meta is None:
			if modified(path_of(sid)) < expire:
				with locked(), contextlib.suppress(FileNotFoundError):
					if read_record(sid) is None:
						os.remove(path_of(sid))  # 壊れたまま作り直されなかった記録
			continue
		stopped, lines = judge(meta)
		# 停止して 7 日たったものと、会話が別のセッションに引き継がれたもの（SessionEnd が来ない）を消す
		if (stopped and modified(path_of(sid)) < expire) or handed_over(lines, meta.get("attached_at")):
			if remove_record(sid, unchanged(digest(meta))):
				continue
			meta = read_record(sid)  # 消す前に再開されていたので、読み直して判定し直す
			if meta is None:
				continue
			stopped, lines = judge(meta)
		meta["server"] = HOST
		# セッションに名前が付いていれば、目的の代わりに表示する（末尾に無ければ、記録係が最後に見た名前）
		meta["label"] = custom_title(lines) or meta.get("title") or meta.get("purpose") or NO_PURPOSE
		if stopped:
			meta["state"] = "stopped"
		elif interrupted(lines) or meta.get("status") == "user_turn" and not meta.get("waiting_for"):
			meta["state"] = "user_turn"
		elif meta.get("status") == "user_turn":
			meta["state"] = "waiting"
		else:
			meta["state"] = "ai_working"
		out.append(meta)
	return out


def run_on_peer(peer, *args, **kw):
	"""相手側で、このスクリプトを標準入力から読ませて動かす"""
	with open(os.path.realpath(__file__), "rb") as script:
		# ssh は引数をつないで相手のシェルに渡すので、引用符で囲む
		return subprocess.run(["ssh"] + SSH_OPTS + [peer, "python3", "-"] + [shlex.quote(a) for a in args], stdin=script, timeout=30, **kw)


def collect(peer):
	"""自分と相手の記録と、相手の記録を読めたか（相手が無ければ真）を返す"""
	records = dump()
	for m in records:
		m["local"] = True  # ホスト名が同じでも、どちらのサーバーの記録か分かるように
	if peer:
		# 相手に届かなくても、自分の分は表示する
		# stderr はパイプにしない（ControlPersist で裏に残る ssh のマスターが握ったままになり、終わりを待って止まる）
		try:
			with tempfile.TemporaryFile() as err:
				r = run_on_peer(peer, "_dump", stdout=subprocess.PIPE, stderr=err)
				if r.returncode != 0:
					err.seek(0)
					raise RuntimeError(err.read().decode(errors="replace").strip())
			records += json.loads(r.stdout)
		except Exception as e:
			print("※ %s の記録を読めませんでした: %s" % (peer, e), file=sys.stderr)
			return records, False
	return records, True


SECTIONS = [("user_turn", "自分の番"), ("waiting", "待機中"), ("ai_working", "AI 作業中"), ("stopped", "停止中")]


def sort_key(m):
	p = m.get("priority") or {}
	imp = IMPORTANCE.get(p.get("importance"), IMPORTANCE["mid"])
	# 同じ重要度・所要時間の中では、指示を出したのが新しい順（まだ指示の無いものは、始めた時刻）
	prompted = parse_time(m.get("last_prompt_at") or m["started_at"]).timestamp()
	return (-imp, EFFORT.get(p.get("effort"), EFFORT["mid"]), -prompted)


def shell_path(path):
	"""シェルにそのまま貼れる形にする（先頭の ~ は展開されるよう引用符の外に出す）"""
	if path == "~" or path.startswith("~/"):
		return "~" + (path[1:] and "/" + shlex.quote(path[2:]))
	return shlex.quote(path)


def ago(iso):
	"""iso の時刻から今までを「N 分前」などで返す"""
	minutes = max(0, int((datetime.now().timestamp() - parse_time(iso).timestamp()) // 60))  # 相手のサーバーの時計が進んでいても負にしない
	if minutes < 60:
		return "%d 分前" % minutes
	if minutes < DAY // 60:
		return "%d 時間前" % (minutes // 60)
	return "%d 日前" % (minutes // (DAY // 60))


def print_session(m, *lines):
	"""[ID]・目的・lines（見出し・中身の組）・場所の順に出す"""
	print("[%s]" % m["session_id"][:4])
	for name, value in (("目的", m["label"]),) + lines + (("場所", "%s:%s" % (m["server"], m["cwd"])),):
		print("    %s：%s" % (name, value))


def show_list(records):
	for state, title in SECTIONS:
		rows = sorted((m for m in records if m["state"] == state), key=sort_key)
		if not rows:
			continue
		print(("── %s " % title).ljust(50, "─"))
		for m in rows:
			if state == "stopped":
				print_session(m, ("再開", "cd %s && claude --resume %s" % (shell_path(m["cwd"]), m["session_id"])))
			else:
				prompt = m.get("last_prompt", "")
				if m.get("last_prompt_at"):
					prompt += "（%s）" % ago(m["last_prompt_at"])
				lines = [("指示", prompt), ("AI", m.get("ai_result", ""))]
				if state == "waiting":
					lines.append(("待機", "、".join(m["waiting_for"])))
				print_session(m, *lines)
			print()


def rm_here(sid, seen_digest, records):
	"""このサーバーの停止中の記録 sid を、呼んだ側で読んだ記録のまま（ハッシュが同じ）なら消す。呼んでいる間に再開されたものは消さない
	records はこのサーバーの dump の結果"""
	m = next((r for r in records if r["session_id"] == sid), None)
	if m is None:  # 一覧を作る前後に、7 日たって消した・壊れていたなど
		if os.path.exists(path_of(sid)):
			sys.exit("記録が壊れています（7 日後に一覧の片付けで消えます）")
		print("記録はすでに消えていました", file=sys.stderr)
		return
	if m["state"] != "stopped":
		sys.exit("動いているセッションの記録は消せません（セッションを閉じれば消えます）")
	if not remove_record(sid, unchanged(seen_digest)):
		sys.exit("記録が変わったので消しませんでした（再開されたなど）。一覧を見直してください")


def main(args):
	from_hook = args[:1] in (["_hook"], ["_record"])
	if from_hook:
		os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)  # 途中のディレクトリ（~/.local など）は、umask を絞る前に普通の権限で作る
	os.umask(0o077)  # 記録には仕事の情報が入るので、どの入口で作るファイルも自分だけが読めるようにする
	if from_hook:
		data = json.load(sys.stdin)
		try:
			(hook if args[0] == "_hook" else record)(data)
		except Exception as e:  # 失敗しても Claude Code の動作は止めない。原因はログに残す
			with open(os.path.join(STATE_DIR, "error.log"), "a") as f:
				f.write("%s %s %s: %r\n" % (now(), args[0], data.get("session_id"), e))
		return
	if args[:1] == ["_dump"]:
		json.dump(dump(), sys.stdout, ensure_ascii=False)
		return
	if args[:1] == ["_rm"]:
		if len(args) != 3:
			sys.exit("使い方: session-dashboard _rm SESSION_ID 呼んだ側で読んだ記録のハッシュ")
		rm_here(args[1], args[2], dump())
		return
	peer = None
	if args[:1] == ["--peer"] and len(args) >= 2:
		peer, args = args[1], args[2:]
	if args and (len(args) != 2 or args[0] != "--rm"):
		sys.exit("使い方: session-dashboard [--peer HOST] [--rm ID]")
	if not args:
		show_list(collect(peer)[0])
	else:
		prefix = args[1]
		local_ids = [sid for sid in session_ids() if sid.startswith(prefix)] if os.path.isdir(STATE_DIR) else []
		records, peer_ok = collect(peer)
		peer_hits = [m for m in records if not m.get("local") and m["session_id"].startswith(prefix)]
		# 一覧を作る前の手元の記録（壊れたもの・一覧を作るときに消えたものを含む）と相手の記録を合わせて数える
		if len(local_ids) + len(peer_hits) > 1:
			sys.exit("ID %s に当たる記録が複数あります。もう少し長く指定してください" % prefix)
		if not peer_ok and local_ids != [prefix]:  # ID を全部指定していれば、相手の記録には当たらない
			sys.exit("%s の記録を読めなかったので、ID %s が相手の記録にも当たるか分かりません。もう一度試してください" % (peer, prefix))
		if not local_ids and not peer_hits:
			sys.exit("ID %s に当たる記録がありません（すでに消えたか、ID の誤り）" % prefix)
		if local_ids:
			local = [r for r in records if r.get("local")]
			m = next((r for r in local if r["session_id"] == local_ids[0]), None)
			rm_here(local_ids[0], m and digest(m), local)
		else:
			m = peer_hits[0]
			try:
				# 記録の中身は渡さない（コマンド行は ps でほかのユーザーにも見える）
				sys.exit(run_on_peer(peer, "_rm", m["session_id"], digest(m)).returncode)  # 失敗の理由は相手側が出す
			except (subprocess.TimeoutExpired, OSError) as e:
				sys.exit("%s の記録を消せませんでした: %s" % (peer, e))


if __name__ == "__main__":
	main(sys.argv[1:])
